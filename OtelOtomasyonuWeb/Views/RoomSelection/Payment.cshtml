@{
    Layout = null;
    var token = ViewBag.Token;
    var customerName = ViewBag.CustomerName;
    var totalAmount = ViewBag.TotalAmount as decimal? ?? 0;
    var stayDays = ViewBag.StayDays as int? ?? 1;
    var reservations = ViewBag.Reservations as List<OtelOtomasyonuWeb.Data.Reservation> ?? new List<OtelOtomasyonuWeb.Data.Reservation>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ödeme - Ada Lovelady's Hotel</title>
    <style>
        body {
            background-color: #000;
            color: #D4AF37;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background-color: #1a1a1a;
            padding: 40px;
            border-radius: 10px;
            border: 2px solid #D4AF37;
        }

        h1 {
            text-align: center;
            border-bottom: 2px solid #D4AF37;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .reservation-summary {
            background-color: #000;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 30px;
            border: 1px solid #333;
        }

        .reservation-item {
            padding: 10px;
            margin-bottom: 10px;
            border-bottom: 1px solid #333;
        }

        .reservation-item:last-child {
            border-bottom: none;
        }

        .total-amount {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            color: #D4AF37;
            margin: 30px 0;
            padding: 20px;
            background-color: #000;
            border: 2px solid #D4AF37;
            border-radius: 5px;
        }

        .payment-form {
            background-color: #000;
            padding: 30px;
            border-radius: 5px;
            border: 1px solid #333;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #D4AF37;
            font-weight: bold;
        }

        input[type="text"],
        input[type="number"],
        input[type="month"] {
            width: 100%;
            padding: 12px;
            background-color: #1a1a1a;
            border: 1px solid #D4AF37;
            border-radius: 5px;
            color: #fff;
            font-size: 16px;
            box-sizing: border-box;
        }

        input[type="text"]:focus,
        input[type="number"]:focus,
        input[type="month"]:focus {
            outline: none;
            border-color: #ffd700;
        }

        .form-row {
            display: flex;
            gap: 15px;
        }

        .form-row .form-group {
            flex: 1;
        }

        button {
            width: 100%;
            padding: 15px;
            background-color: #D4AF37;
            color: #000;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }

        button:hover {
            background-color: #ffd700;
            transform: scale(1.02);
        }

        button:disabled {
            background-color: #555;
            color: #888;
            cursor: not-allowed;
        }

        .info-text {
            color: #888;
            font-size: 14px;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Ödeme</h1>
        
        <div class="reservation-summary">
            <h3 style="margin-top: 0; color: #D4AF37;">Rezervasyon Özeti</h3>
            <p><strong>Müşteri:</strong> @customerName</p>
            <p><strong>Kalış Süresi:</strong> @stayDays Gün</p>
            <div style="margin-top: 15px;">
                <strong>Seçilen Odalar:</strong>
                @{
                    var rooms = ViewBag.Rooms as List<OtelOtomasyonuWeb.Data.Room> ?? new List<OtelOtomasyonuWeb.Data.Room>();
                }
                @foreach (var res in reservations)
                {
                    <div class="reservation-item">
                        @{
                            var roomInfo = rooms.FirstOrDefault(r => r.Id == res.RoomId);
                            var roomPrice = roomInfo != null ? roomInfo.Price : 0;
                            var roomNumber = roomInfo != null ? roomInfo.RoomNumber : "Bilinmiyor";
                        }
                        <div>Oda @roomNumber - @roomPrice.ToString("N2") TL/gün × @stayDays gün = @((roomPrice * stayDays).ToString("N2")) TL</div>
                    </div>
                }
            </div>
        </div>

        <div class="total-amount">
            Toplam Tutar: @totalAmount.ToString("N2") TL
        </div>

        <div class="payment-form">
            <h3 style="margin-top: 0; color: #D4AF37;">Ödeme Bilgileri (Simülasyon)</h3>
            <p style="color: #888; font-size: 14px; margin-bottom: 20px;">
                Bu bir ödeme simülasyonudur. Gerçek ödeme işlemi yapılmamaktadır.
            </p>

            <form id="paymentForm">
                <div class="form-group">
                    <label>Kart Numarası:</label>
                    <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required />
                    <div class="info-text">Test için herhangi bir numara girebilirsiniz</div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Son Kullanma Tarihi:</label>
                        <input type="month" id="expiryDate" required />
                    </div>
                    <div class="form-group">
                        <label>CVV:</label>
                        <input type="number" id="cvv" placeholder="123" maxlength="3" min="100" max="999" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Kart Sahibi Adı:</label>
                    <input type="text" id="cardHolder" placeholder="@customerName" required />
                </div>

                <button type="submit" id="btnPay">ÖDEMEYİ TAMAMLA</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            var btnPay = document.getElementById('btnPay');
            btnPay.disabled = true;
            btnPay.textContent = 'Ödeme İşleniyor...';

            var token = '@Html.Raw(token?.ToString() ?? "")';

            // Ödeme simülasyonu - her zaman başarılı
            fetch('/RoomSelection/ProcessPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'token=' + encodeURIComponent(token)
            })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error('HTTP ' + response.status + ': ' + text);
                    });
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl || '/RoomSelection/PaymentSuccess';
                } else {
                    alert("Hata: " + (data.message || "Bilinmeyen hata"));
                    btnPay.disabled = false;
                    btnPay.textContent = 'ÖDEMEYİ TAMAMLA';
                }
            })
            .catch(error => {
                console.error('Error details:', error);
                alert("Bir hata oluştu: " + error.message);
                btnPay.disabled = false;
                btnPay.textContent = 'ÖDEMEYİ TAMAMLA';
            });
        });

        // Kart numarası formatı (4 haneli gruplar)
        document.getElementById('cardNumber').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\s/g, '');
            var formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });
    </script>
</body>
</html>

