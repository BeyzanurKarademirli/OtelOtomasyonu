@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ada Lovelady's Hotel - Rezervasyon Başarılı</title>
    <style>
        body {
            background-color: #000;
            color: #D4AF37;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .success-container {
            text-align: center;
            padding: 40px;
            border: 2px solid #D4AF37;
            border-radius: 10px;
            background-color: #1a1a1a;
            max-width: 600px;
        }

        h1 {
            color: #D4AF37;
            font-size: 32px;
            margin-bottom: 20px;
        }

        .success-icon {
            font-size: 80px;
            color: #00ff00;
            margin-bottom: 20px;
        }

        p {
            color: #fff;
            font-size: 18px;
            line-height: 1.6;
        }

        .room-info {
            background-color: #000;
            padding: 20px;
            border-radius: 5px;
            margin: 20px 0;
            border: 1px solid #D4AF37;
        }

        .room-info h2 {
            color: #D4AF37;
            margin-top: 0;
        }
    </style>
</head>
<body>
    <div class="success-container">
        <div class="success-icon">✓</div>
        <h1>Rezervasyonunuz Başarıyla Tamamlandı!</h1>
        <p>Odanız başarıyla seçildi ve rezervasyonunuz oluşturuldu.</p>
        <div class="room-info">
            <h2>İyi Tatiller!</h2>
            <p>Ada Lovelady's Hotel'de konforlu bir konaklama dileriz.</p>
        </div>
        <p style="color: #888; font-size: 14px;">Bu sayfayı kapatabilirsiniz.</p>
    </div>
</body>
</html>

